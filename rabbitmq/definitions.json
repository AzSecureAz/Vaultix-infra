{
  "vhosts": [
    {
      "name": "/"
    }
  ],
  "users": [
    {
      "name": "auth_user",
      "password": "auth_password",
      "tags": [
        "management"
      ]
    },
    {
      "name": "notification_user",
      "password": "notification_password",
      "tags": [
        "management"
      ]
    }
  ],
  "permissions": [
    {
      "user": "auth_user",
      "vhost": "/",
      "configure": "^auth\\..*",
      "write": "^auth\\..*",
      "read": "^$"
    },
    {
      "user": "notification_user",
      "vhost": "/",
      "configure": "^notification\\..*",
      "write": "^notification\\..*",
      "read": ".*"
    }
  ],
  "exchanges": [
    {
      "name": "auth.exchange",
      "vhost": "/",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "notification.auth",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],
  "bindings": [
    {
      "source": "auth.exchange",
      "vhost": "/",
      "destination": "notification.auth",
      "destination_type": "queue",
      "routing_key": "auth.notification.*",
      "arguments": {}
    }
  ]
}